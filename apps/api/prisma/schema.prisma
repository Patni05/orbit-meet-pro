// Orbit — data model.
//
// Media never touches PostgreSQL. This schema stores identity, meeting
// metadata, membership, chat history and audit events only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SystemRole {
  USER
  ADMIN
}

enum MeetingStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum ParticipantRole {
  HOST
  COHOST
  PARTICIPANT
}

enum ParticipantStatus {
  WAITING
  ADMITTED
  REJECTED
  LEFT
  REMOVED
}

enum RecordingStatus {
  STARTING
  ACTIVE
  STOPPING
  COMPLETED
  FAILED
}

enum ScreenShareMode {
  EVERYONE
  HOSTS_ONLY
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  name         String
  /// Argon2id hash. Plain-text passwords are never stored or logged.
  passwordHash String
  avatarUrl    String?
  role         SystemRole @default(USER)
  emailVerified Boolean   @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  lastActiveAt DateTime?

  refreshTokens       RefreshToken[]
  passwordResets      PasswordResetToken[]
  hostedMeetings      Meeting[]            @relation("MeetingHost")
  participations      MeetingParticipant[]
  invitesSent         MeetingInvite[]      @relation("InviteSender")
  chatMessages        ChatMessage[]
  meetingEvents       MeetingEvent[]

  @@index([lastActiveAt])
  blockedEntries      MeetingBlocklistEntry[] @relation("BlockedUser")
  blocksIssued        MeetingBlocklistEntry[] @relation("BlockedByUser")
  announcements       MeetingAnnouncement[]
  pollsCreated        Poll[]
  quizzesCreated      Quiz[]
}

/// Rotating refresh tokens. Only the SHA-256 hash of the token is stored.
model RefreshToken {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  /// Chains rotations so reuse of a retired token can revoke the whole family.
  familyId   String
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedById String?
  userAgent  String?
  ipHash     String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Meeting {
  id     String @id @default(uuid())
  /// Public, high-entropy code used in URLs: `abcd-efgh-ijkl`.
  code   String @unique
  hostId String

  title       String
  description String?
  /// Argon2id hash of the optional passcode. Never the passcode itself.
  passwordHash String?

  status      MeetingStatus @default(SCHEDULED)
  locked      Boolean       @default(false)

  scheduledAt     DateTime?
  durationMinutes Int?
  timezone        String?
  startedAt       DateTime?
  endedAt         DateTime?

  // ---- settings (host policy, enforced server-side) ----
  waitingRoomEnabled   Boolean         @default(false)
  requireAuth          Boolean         @default(false)
  allowGuests          Boolean         @default(true)
  chatEnabled          Boolean         @default(true)
  screenShareMode      ScreenShareMode @default(EVERYONE)
  allowParticipantUnmute Boolean       @default(true)
  muteOnEntry          Boolean         @default(false)
  recordingEnabled     Boolean         @default(false)

  /// Identities the host has spotlighted for everyone. Distinct from a
  /// personal pin, which is a viewer-only preference and never stored.
  spotlightIdentities String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  host         User                 @relation("MeetingHost", fields: [hostId], references: [id], onDelete: Cascade)
  participants MeetingParticipant[]
  invites      MeetingInvite[]
  messages     ChatMessage[]
  recordings   Recording[]
  events       MeetingEvent[]
  blocklist    MeetingBlocklistEntry[]
  announcements MeetingAnnouncement[]
  polls        Poll[]
  quizzes      Quiz[]

  @@index([hostId, status])
  @@index([scheduledAt])
  @@index([status])
}

model MeetingParticipant {
  id        String @id @default(uuid())
  meetingId String
  userId    String?

  /// LiveKit identity + realtime key. Unique per meeting, stable across reconnects.
  identity    String
  /// Per-tab session id supplied by the client; lets a refresh resume this row.
  sessionId   String?
  displayName String
  avatarUrl   String?
  isGuest     Boolean @default(false)

  role   ParticipantRole   @default(PARTICIPANT)
  status ParticipantStatus @default(ADMITTED)

  joinedAt     DateTime?
  leftAt       DateTime?
  lastSeenAt   DateTime  @default(now())
  handRaisedAt DateTime?
  connected    Boolean   @default(false)

  micEnabled    Boolean @default(false)
  cameraEnabled Boolean @default(false)
  screenSharing Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  pollVotes PollVote[]
  quizAttempts QuizParticipant[]

  @@unique([meetingId, identity])
  @@index([meetingId, status])
  @@index([userId])
}

model MeetingInvite {
  id        String   @id @default(uuid())
  meetingId String
  invitedById String
  email     String?
  /// Optional single-use token for targeted invitations.
  tokenHash String?  @unique
  acceptedAt DateTime?
  expiresAt DateTime?
  createdAt DateTime @default(now())

  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  invitedBy User    @relation("InviteSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@index([email])
}

model ChatMessage {
  id             String   @id @default(uuid())
  meetingId      String
  senderId       String?
  senderIdentity String
  senderName     String
  /// Stored as plain text. Rendered as text by clients — never as HTML.
  body           String
  sentAt         DateTime @default(now())
  deletedAt      DateTime?

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  sender  User?   @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([meetingId, sentAt])
}

model Recording {
  id           String          @id @default(uuid())
  meetingId    String
  /// LiveKit egress id, used to stop the recording later.
  egressId     String?         @unique
  status       RecordingStatus @default(STARTING)
  startedAt    DateTime        @default(now())
  endedAt      DateTime?
  fileLocation String?
  sizeBytes    BigInt?
  durationSec  Int?
  startedById  String?
  error        String?

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}

/// Append-only audit trail: joins, leaves, host actions, lock/end, errors.
model MeetingEvent {
  id        String   @id @default(uuid())
  meetingId String
  actorId   String?
  actorIdentity String?
  type      String
  payload   Json?
  createdAt DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([meetingId, createdAt])
  @@index([type])
}

// ---------------------------------------------------------------------------
// Moderation, announcements and live polling
// ---------------------------------------------------------------------------

/// Why a participant was blocked, kept for the host's own audit trail.
enum BlockScope {
  /// Identified by their signed-in account: survives new sessions and devices.
  USER
  /// Identified by the meeting-scoped guest identity, which is all an
  /// anonymous participant has. Weaker, but never a device fingerprint.
  GUEST_IDENTITY
}

/// A participant barred from re-entering one meeting.
///
/// Scoped to the meeting rather than global: being removed from one call says
/// nothing about any other. Blocking a signed-in user is durable because the
/// account is durable; a guest can only be matched on their meeting identity,
/// which is the strongest handle available without fingerprinting the device.
model MeetingBlocklistEntry {
  id        String     @id @default(uuid())
  meetingId String
  scope     BlockScope

  /// Set when scope is USER.
  userId    String?
  /// Set when scope is GUEST_IDENTITY.
  identity  String?

  /// Kept only so the host can recognise the entry in the management panel.
  displayName String
  reason      String?

  blockedById String
  createdAt   DateTime @default(now())

  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user      User?   @relation("BlockedUser", fields: [userId], references: [id], onDelete: Cascade)
  blockedBy User    @relation("BlockedByUser", fields: [blockedById], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@unique([meetingId, identity])
  @@index([meetingId])
}

/// A short message a host pushes to everyone in the meeting.
model MeetingAnnouncement {
  id        String   @id @default(uuid())
  meetingId String
  body      String
  createdById String
  createdAt DateTime @default(now())
  /// Cleared by the host, or superseded by a newer announcement.
  dismissedAt DateTime?

  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([meetingId, createdAt])
}

enum PollStatus {
  DRAFT
  OPEN
  CLOSED
}

/// A live poll: opinions, no correct answer. Quizzes are a separate model
/// because they need an answer key, scoring and ranking.
model Poll {
  id        String     @id @default(uuid())
  meetingId String
  question  String
  status    PollStatus @default(DRAFT)

  /// Multiple selections allowed per voter.
  multiSelect Boolean @default(false)
  /// Voter identity is not stored against the vote.
  anonymous   Boolean @default(false)
  /// Hide the tally from participants until the poll closes.
  hideResultsUntilClosed Boolean @default(true)

  createdById String
  createdAt   DateTime  @default(now())
  openedAt    DateTime?
  closedAt    DateTime?

  meeting   Meeting      @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  createdBy User         @relation(fields: [createdById], references: [id], onDelete: Cascade)
  options   PollOption[]
  votes     PollVote[]

  @@index([meetingId, status])
}

model PollOption {
  id     String @id @default(uuid())
  pollId String
  label  String
  /// Display order, so options do not shuffle between renders.
  position Int

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@index([pollId, position])
}

model PollVote {
  id       String @id @default(uuid())
  pollId   String
  optionId String
  /// The participant row, not the user: guests vote too.
  participantId String

  createdAt DateTime @default(now())

  poll   Poll               @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption         @relation(fields: [optionId], references: [id], onDelete: Cascade)
  participant MeetingParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  /// One vote per option per participant; multi-select adds rows, never
  /// duplicates, and a re-vote replaces rather than stacking.
  @@unique([pollId, participantId, optionId])
  @@index([pollId])
}

// ---------------------------------------------------------------------------
// Live quiz / exam
// ---------------------------------------------------------------------------
//
// Separate from Poll on purpose. A poll collects opinions and has no wrong
// answer; a quiz has an answer key, a server-held clock, scoring and a
// ranking. Sharing one model would mean either polls carrying dead scoring
// columns or quizzes storing their answer key somewhere untyped.

enum QuizStatus {
  DRAFT
  RUNNING
  ENDED
}

enum QuizTimerMode {
  /// Each question carries its own countdown.
  PER_QUESTION
  /// One clock for the whole quiz.
  TOTAL
}

enum QuizFlow {
  /// The host advances everyone together.
  ONE_AT_A_TIME
  /// Participants navigate freely until they submit or time runs out.
  ALL_AT_ONCE
}

enum QuizQuestionKind {
  SINGLE
  MULTI
  TRUE_FALSE
}

enum QuizResultVisibility {
  LEADERBOARD_AND_ANSWERS
  LEADERBOARD_ONLY
  OWN_ONLY
  HOST_ONLY
}

enum QuizRevealMode {
  AFTER_EACH_QUESTION
  AT_END
  NEVER
}

model Quiz {
  id        String     @id @default(uuid())
  meetingId String
  title     String
  status    QuizStatus @default(DRAFT)

  timerMode QuizTimerMode @default(TOTAL)
  flow      QuizFlow      @default(ALL_AT_ONCE)
  /// Used when timerMode is TOTAL.
  totalSeconds Int        @default(300)

  shuffleQuestions Boolean @default(false)
  shuffleOptions   Boolean @default(false)

  /// Off by default, and participants are told before they start when it is on.
  negativeMarking Boolean @default(false)
  negativePoints  Int     @default(1)

  allowLateJoin     Boolean @default(true)
  allowAnswerChange Boolean @default(false)

  resultVisibility QuizResultVisibility @default(LEADERBOARD_AND_ANSWERS)
  revealMode       QuizRevealMode       @default(AT_END)

  createdById String
  createdAt   DateTime  @default(now())

  /// The authoritative clock. Clients render a countdown from these instants
  /// rather than running their own timer, so a refresh cannot buy more time.
  startedAt DateTime?
  endsAt    DateTime?
  endedAt   DateTime?

  /// For ONE_AT_A_TIME flow: which question is currently open.
  currentQuestionIndex Int      @default(0)
  currentQuestionEndsAt DateTime?

  meeting      Meeting           @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  createdBy    User              @relation(fields: [createdById], references: [id], onDelete: Cascade)
  questions    QuizQuestion[]
  participants QuizParticipant[]

  @@index([meetingId, status])
}

model QuizQuestion {
  id       String           @id @default(uuid())
  quizId   String
  position Int
  kind     QuizQuestionKind @default(SINGLE)
  prompt   String
  points   Int              @default(10)
  /// Used when timerMode is PER_QUESTION.
  seconds  Int              @default(30)
  /// Shown after the answer is revealed, for teaching.
  explanation String?

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options QuizOption[]
  answers QuizAnswer[]

  @@index([quizId, position])
}

model QuizOption {
  id         String  @id @default(uuid())
  questionId String
  position   Int
  label      String
  /// Never serialised to a participant before the configured reveal point.
  isCorrect  Boolean @default(false)

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, position])
}

/// One person's attempt. The unique constraint is what makes a second
/// submission impossible, including from a second browser tab.
model QuizParticipant {
  id            String @id @default(uuid())
  quizId        String
  participantId String
  displayName   String
  avatarUrl     String?

  startedAt   DateTime  @default(now())
  submittedAt DateTime?

  /// Populated by the server at grading time. Never accepted from a client.
  score            Int   @default(0)
  correctCount     Int   @default(0)
  wrongCount       Int   @default(0)
  unansweredCount  Int   @default(0)
  timeTakenMs      Int   @default(0)

  /// Informational only, never used to accuse anyone of anything.
  awayCount Int @default(0)

  quiz        Quiz               @relation(fields: [quizId], references: [id], onDelete: Cascade)
  participant MeetingParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  answers     QuizAnswer[]

  @@unique([quizId, participantId])
  @@index([quizId, score])
}

model QuizAnswer {
  id                String   @id @default(uuid())
  quizParticipantId String
  questionId        String
  /// Selected option ids. An empty array is a deliberate "no answer".
  optionIds         String[]
  answeredAt        DateTime @default(now())

  /// Graded server-side once the quiz ends.
  isCorrect Boolean @default(false)
  awarded   Int     @default(0)

  quizParticipant QuizParticipant @relation(fields: [quizParticipantId], references: [id], onDelete: Cascade)
  question        QuizQuestion    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  /// One answer row per question per attempt; re-answering updates in place.
  @@unique([quizParticipantId, questionId])
  @@index([questionId])
}
