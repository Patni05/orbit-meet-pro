# ---------------------------------------------------------------------------
# Orbit — environment template
#
# Copy to `.env` and fill in real values:   cp .env.example .env
# Generate strong secrets with:             node scripts/gen-secrets.mjs
#
# NEVER commit a real .env. Every value below is a development placeholder.
# ---------------------------------------------------------------------------

# ----- runtime -----
NODE_ENV=development
LOG_LEVEL=info

# ----- api -----
PORT=4000
HOST=0.0.0.0
API_URL=http://localhost:4000
APP_URL=http://localhost:3000
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# ----- database -----
# Matches the docker-compose postgres service.
DATABASE_URL=postgresql://orbit:orbit_dev_password@localhost:5432/orbit?schema=public
POSTGRES_USER=orbit
POSTGRES_PASSWORD=orbit_dev_password
POSTGRES_DB=orbit

# ----- redis -----
REDIS_URL=redis://localhost:6379

# ----- auth -----
# Must be at least 32 characters. Replace both before any deployment.
JWT_SECRET=dev-only-insecure-secret-change-me-now-0001
JWT_REFRESH_SECRET=dev-only-insecure-secret-change-me-now-0002
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Cookie behaviour for the refresh token.
# Set COOKIE_SECURE=true and COOKIE_SAMESITE=none when web and api are on
# different hostnames over HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.example.com

# ----- LiveKit SFU -----
# Server-to-server admin endpoint (http/https).
LIVEKIT_URL=http://localhost:7880
# WebSocket endpoint handed to browsers (ws/wss). Must be wss:// in production.
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecretdevsecretdevsecretdevsecret
# Lifetime of a participant token, in seconds (default 6 hours).
LIVEKIT_TOKEN_TTL_SECONDS=21600

# IP that LiveKit advertises in ICE candidates.
#   127.0.0.1      -> same machine only (default, good for two browser tabs)
#   192.168.x.x    -> your LAN IP, required to test from a phone or a second computer
#   <public ip>    -> a real deployment
LIVEKIT_NODE_IP=127.0.0.1

# ----- TURN (needed when participants sit behind strict NAT/firewalls) -----
TURN_URL=turn:localhost:3478
TURN_USERNAME=orbit
TURN_PASSWORD=orbit_dev_turn_password
# Public IP of the TURN server; required for coturn to relay correctly.
TURN_EXTERNAL_IP=127.0.0.1
TURN_REALM=orbit.local

# ----- recording (LiveKit Egress) -----
# Off by default: it needs the egress service from docker-compose profile "recording".
RECORDING_ENABLED=false
RECORDING_OUTPUT_DIR=/recordings
# Where the API reads those files from. Egress writes inside its container;
# docker compose maps ./recordings to /recordings, so the host path differs.
RECORDING_LOCAL_DIR=./recordings

# ----- rate limiting -----
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# ----- diagnostics -----
# Exposes the in-meeting diagnostics panel. Keep false in production.
ENABLE_DEBUG_ENDPOINTS=true

# ----- web (Next.js public config; these ARE visible in the browser) -----
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
